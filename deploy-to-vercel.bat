@echo off
chcp 65001 >nul
title Nose Tea — Deploy to Vercel (vercel.app)
color 0A
cls
echo ======================================================================
echo   🧋 NOSE TEA : THE CLOUD SERIES — 1-CLICK DEPLOY TO VERCEL
echo ======================================================================
echo.
echo กำลังเริ่มกระบวนการส่งเว็บไซต์ขึ้น Vercel (vercel.app)...
echo.
echo 💡 สิ่งที่จะเกิดขึ้น:
echo   1. หน้าต่างเบราว์เซอร์จะเปิดขึ้นมาเพื่อให้คุณยืนยันการเข้าสู่ระบบ Vercel
echo      (กดเลือกบัญชี Google ที่คุณเพิ่งล็อกอินไว้ได้เลยครับ)
echo   2. ระบบจะอัปโหลดไฟล์เว็บขึ้น Vercel ให้อัตโนมัติ
echo   3. เมื่อเสร็จสิ้น คุณจะได้ลิงก์ https://xxx.vercel.app พร้อมใช้งานทันที!
echo.
echo ======================================================================
echo.

cd /d "%~dp0"
"C:\Program Files\nodejs\npx.cmd" vercel --prod

echo.
echo ======================================================================
echo   🎉 เสร็จสิ้นกระบวนการเรียบร้อยแล้วครับ!
echo   คุณสามารถคัดลอกลิงก์ด้านบนส่งให้คนนอกเปิดดูได้เลยครับ
echo ======================================================================
echo.
pause
